# ==============================================================================
# Environment Configuration Template - Project J26-IT-358
# Instructions: Copy this file to .env and adjust values if needed.
# DO NOT commit your actual .env file with real secrets to GitHub.
# ==============================================================================

# --- Project Environment ---
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="AgriDecision-LK"

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Shared PostgreSQL + PostGIS Database ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=your_postgres_db_name_here
DATABASE_URL=postgresql://your_postgres_user_here:your_postgres_password_here@localhost:5432/your_postgres_db_name_here

# --- Redis & Celery Message Broker ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Microservices Port Assignments ---
PORT_GATEWAY=8000
PORT_MARKET_PROFIT_SERVICE=8001          # Component 1 (Ranadewa)
PORT_CULTIVATION_SERVICE=8002            # Component 2 (Uthpala)
PORT_WASTE_BIOECONOMY_SERVICE=8003       # Component 3 (Lakruwan)
PORT_CLIMATE_YIELD_SERVICE=8004          # Component 4 (Deshapriya)
PORT_FRONTEND=3000                       # Next.js Web App

# --- External API Keys (Component 4) ---
NASA_POWER_API_BASE=https://power.larc.nasa.gov/api/temporal/daily/point
COPERNICUS_CDS_API_KEY=your_copernicus_cds_api_key_here
