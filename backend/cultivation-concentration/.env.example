CULTIVATION_FARMER_TOKENS={}
CULTIVATION_ANALYSIS_TOKENS=[]
CULTIVATION_ADMIN_TOKENS=[]
CULTIVATION_REVIEWER_TOKENS={}

# Persistent accounts and sessions use the same DB as cultivation plans.
CULTIVATION_PLAN_DB=storage/cultivation_plans.sqlite3
# Absolute session lifetime in seconds: 60-86400, default 3600. No signing secret needed.
CULTIVATION_SESSION_TTL_SECONDS=3600
# Preserve pre-provisioned research farmers; set false for account-only deployment.
# Analyst/admin/reviewer registries remain independent of this switch.
CULTIVATION_LEGACY_FARMER_TOKENS_ENABLED=true

# Explicit frontend origin allowlist (JSON array); defaults to [] when unset.
# Origin = scheme + host + optional port, with no path/trailing slash/wildcard.
# Example local frontend only; replace with reviewed origins for deployment.
CULTIVATION_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
